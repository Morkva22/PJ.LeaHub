@page
@model Registr.asp.Pages.RegisterModel
@{
    ViewData["Title"] = "Player Registration";
}

<h2>Player Registration</h2>

<form method="post">
    <div>
        <input asp-for="Player.Login" />
        <span asp-validation-for="Player.Login"></span>
    </div>

    <div>
        <input asp-for="Player.DateOfBirth" type="date" />
        <span asp-validation-for="Player.DateOfBirth"></span>
    </div>

    <div>
        <input asp-for="Player.Password" type="password" />
        <span asp-validation-for="Player.Password"></span>
    </div>

    <div>
        <input asp-for="Player.PasswordConfirmation" type="password" />
        <span asp-validation-for="Player.PasswordConfirmation"></span>
    </div>

    <div>
        <input asp-for="Player.PasswordReconfirmation" type="password" />
        <span asp-validation-for="Player.PasswordReconfirmation"></span>
    </div>

    <div>
        <input asp-for="Player.PhoneNumber" />
        <span asp-validation-for="Player.PhoneNumber"></span>
    </div>

    <div>
        <input asp-for="Player.ProfileUrl" />
        <span asp-validation-for="Player.ProfileUrl"></span>
    </div>

    <div>
        <button type="submit">Register</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}