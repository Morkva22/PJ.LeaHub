@page
@model DTO4.ASP.Pages.EventRegistrationModel
@{
    ViewData["Title"] = "Event Registration";
}

<div class="container">
    <h1>Event Registration Form</h1>

    @if (Model.FormSubmitted && Model.Registration != null)
    {
        <div class="mt-4 mb-4">
            <h3>Registration Summary</h3>
            <table class="table table-bordered">
                <tbody>
                <tr>
                    <th>Full Name</th>
                    <td>@Model.Registration.FullName</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Model.Registration.Email</td>
                </tr>
                <tr>
                    <th>Phone Number</th>
                    <td>@Model.Registration.PhoneNumber</td>
                </tr>
                <tr>
                    <th>Age</th>
                    <td>@Model.Registration.Age</td>
                </tr>
                <tr>
                    <th>Ticket Quantity</th>
                    <td>@Model.Registration.TicketQuantity</td>
                </tr>
                <tr>
                    <th>Ticket Type</th>
                    <td>@Model.Registration.TicketType</td>
                </tr>
                <tr>
                    <th>Participation Format</th>
                    <td>@Model.Registration.ParticipationFormat</td>
                </tr>
                <tr>
                    <th>Lunch Included</th>
                    <td>@(Model.Registration.LunchIncluded ? "Yes" : "No")</td>
                </tr>
                <tr>
                    <th>Certificate Needed</th>
                    <td>@(Model.Registration.CertificateNeeded ? "Yes" : "No")</td>
                </tr>
                <tr>
                    <th>Comment</th>
                    <td>@(string.IsNullOrEmpty(Model.Registration.Comment) ? "No comment" : Model.Registration.Comment)</td>
                </tr>
                </tbody>
            </table>
        </div>
    }

    <form method="post" class="mt-4">
        <div class="card mb-3">
            <div class="card-header">
                <h4>Personal Information</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="FullName" class="form-label">Full Name</label>
                    <input type="text" class="form-control" id="FullName" name="Registration.FullName" required />
                </div>

                <div class="mb-3">
                    <label for="Email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="Email" name="Registration.Email" required />
                </div>

                <div class="mb-3">
                    <label for="PhoneNumber" class="form-label">Phone Number</label>
                    <input type="tel" class="form-control" id="PhoneNumber" name="Registration.PhoneNumber" required />
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Participation Details</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="Age" class="form-label">Age</label>
                    <input type="number" class="form-control" id="Age" name="Registration.Age" min="1" required />
                </div>

                <div class="mb-3">
                    <label for="TicketQuantity" class="form-label">Number of Tickets</label>
                    <input type="number" class="form-control" id="TicketQuantity" name="Registration.TicketQuantity" min="1" required />
                </div>

                <div class="mb-3">
                    <label for="TicketType" class="form-label">Ticket Type</label>
                    <select class="form-select" id="TicketType" name="Registration.TicketType" required>
                        @foreach (var ticketType in Enum.GetValues(typeof(EventRegistrationModel.TicketType)))
                        {
                            <option value="@ticketType">@ticketType</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Participation Format</h4>
            </div>
            <div class="card-body">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Registration.ParticipationFormat" id="Online" value="Online" required />
                    <label class="form-check-label" for="Online">
                        Online
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Registration.ParticipationFormat" id="Offline" value="Offline" />
                    <label class="form-check-label" for="Offline">
                        Offline
                    </label>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Additional Options</h4>
            </div>
            <div class="card-body">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="Registration.LunchIncluded" id="LunchIncluded" />
                    <label class="form-check-label" for="LunchIncluded">
                        Lunch Included
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Registration.CertificateNeeded" id="CertificateNeeded" />
                    <label class="form-check-label" for="CertificateNeeded">
                        Certificate Needed
                    </label>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Comment</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="Comment" class="form-label">Your Comment</label>
                    <textarea class="form-control" id="Comment" name="Registration.Comment" rows="4"></textarea>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Submit Registration</button>
    </form>
</div>