@page
@model DTO5.ASP.Pages.EventRegistrationModel
@{
    ViewData["Title"] = "Event Registration";
}

<div class="container">
    <h1>Event Registration Form</h1>

    @if (Model.FormSubmitted && Model.Registration != null)
    {
        <div class="mt-4 mb-4">
            <h3>Registration Summary</h3>
            <table class="table table-bordered">
                <tbody>
                <tr>
                    <th>Full Name</th>
                    <td>@Model.Registration.FullName</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Model.Registration.Email</td>
                </tr>
                <tr>
                    <th>Phone Number</th>
                    <td>@Model.Registration.PhoneNumber</td>
                </tr>
                <tr>
                    <th>Age</th>
                    <td>@Model.Registration.Age</td>
                </tr>
                <tr>
                    <th>Ticket Quantity</th>
                    <td>@Model.Registration.TicketQuantity</td>
                </tr>
                <tr>
                    <th>Ticket Type</th>
                    <td>@Model.Registration.TicketType</td>
                </tr>
                <tr>
                    <th>Participation Format</th>
                    <td>@Model.Registration.ParticipationFormat</td>
                </tr>
                <tr>
                    <th>Lunch Included</th>
                    <td>@(Model.Registration.LunchIncluded ? "Yes" : "No")</td>
                </tr>
                <tr>
                    <th>Certificate Needed</th>
                    <td>@(Model.Registration.CertificateNeeded ? "Yes" : "No")</td>
                </tr>
                <tr>
                    <th>Comment</th>
                    <td>@(string.IsNullOrEmpty(Model.Registration.Comment) ? "No comment" : Model.Registration.Comment)</td>
                </tr>
                </tbody>
            </table>
        </div>
    }

    <form method="post" class="mt-4">
        <div class="card mb-3">
            <div class="card-header">
                <h4>Personal Information</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Registration.FullName" class="form-label">Full Name</label>
                    <input asp-for="Registration.FullName" class="form-control" />
                    <span asp-validation-for="Registration.FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Registration.Email" class="form-label">Email</label>
                    <input asp-for="Registration.Email" type="email" class="form-control" />
                    <span asp-validation-for="Registration.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Registration.PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="Registration.PhoneNumber" type="tel" class="form-control" />
                    <span asp-validation-for="Registration.PhoneNumber" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Participation Details</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Registration.Age" class="form-label">Age</label>
                    <input asp-for="Registration.Age" type="number" class="form-control" />
                    <span asp-validation-for="Registration.Age" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Registration.TicketQuantity" class="form-label">Number of Tickets</label>
                    <input asp-for="Registration.TicketQuantity" type="number" class="form-control" />
                    <span asp-validation-for="Registration.TicketQuantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Registration.TicketType" class="form-label">Ticket Type</label>
                    <select asp-for="Registration.TicketType" class="form-select">
                        @foreach (DTO5.ASP.Pages.EventRegistrationModel.TicketType ticketType in Enum.GetValues(typeof(DTO5.ASP.Pages.EventRegistrationModel.TicketType)))
                        {
                            <option value="@ticketType">@ticketType</option>
                        }
                    </select>
                    <span asp-validation-for="Registration.TicketType" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Participation Format</h4>
            </div>
            <div class="card-body">
                <div class="form-check">
                    <input asp-for="Registration.ParticipationFormat" class="form-check-input" type="radio" value="Online" id="Online" />
                    <label class="form-check-label" for="Online">
                        Online
                    </label>
                </div>
                <div class="form-check">
                    <input asp-for="Registration.ParticipationFormat" class="form-check-input" type="radio" value="Offline" id="Offline" />
                    <label class="form-check-label" for="Offline">
                        Offline
                    </label>
                </div>
                <span asp-validation-for="Registration.ParticipationFormat" class="text-danger"></span>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Additional Options</h4>
            </div>
            <div class="card-body">
                <div class="form-check mb-2">
                    <input asp-for="Registration.LunchIncluded" class="form-check-input" type="checkbox" />
                    <label asp-for="Registration.LunchIncluded" class="form-check-label">
                        Lunch Included
                    </label>
                </div>
                <div class="form-check">
                    <input asp-for="Registration.CertificateNeeded" class="form-check-input" type="checkbox" />
                    <label asp-for="Registration.CertificateNeeded" class="form-check-label">
                        Certificate Needed
                    </label>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h4>Comment</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Registration.Comment" class="form-label">Your Comment</label>
                    <textarea asp-for="Registration.Comment" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Submit Registration</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}