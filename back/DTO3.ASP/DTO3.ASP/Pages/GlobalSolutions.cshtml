@page
@model DTO3.ASP.Pages.GlobalSolutionsModel

@section Title {
    Global Solutions
}

@section Styles {
    <style>
        body {
            background-color: #fff5e6;
        }
        .company-name {
            color: #cc6600;
        }
        .company-description {
            background-color: #ffe6cc;
            padding: 15px;
            border-radius: 5px;
        }
    </style>
}

@section CompanyName {
    <h1 class="company-name">Global Solutions</h1>
}

@section CompanyDescription {
    <div class="company-description">
        <p>Global Solutions provides comprehensive business consulting and management services worldwide. Our expertise helps companies achieve their strategic goals.</p>
    </div>
}

<div class="content-section mt-4">
    <h2>Company Information</h2>
    <p><strong>Founded:</strong> 2005</p>
    <p><strong>Employees:</strong> 1200+</p>
    <p><strong>Location:</strong> New York, USA</p>
    <p><strong>Services:</strong> Business Consulting, Project Management, Strategic Planning</p>
</div>