@page
@model DTO2.ASP.Pages.ProductsModel
@{
    ViewData["Title"] = "Products";
}

<div>
    <h1>Product List</h1>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Available</th>
            <th>Discount</th>
            <th>Created Date</th>
            <th>Category</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>$@product.Price</td>
                <td>@product.Quantity</td>
                <td>@(product.IsAvailable ? "Available" : "Not Available")</td>
                <td>@(product.IsDiscounted ? "Has Discount" : "No Discount")</td>
                <td>@product.CreatedDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @switch (product.Category)
                    {
                        case ProductsModel.ProductCategory.Electronics:
                            <span>Electronics</span>
                            break;
                        case ProductsModel.ProductCategory.Food:
                            <span>Food</span>
                            break;
                        case ProductsModel.ProductCategory.Clothing:
                            <span>Clothing</span>
                            break;
                        case ProductsModel.ProductCategory.Books:
                            <span>Books</span>
                            break;
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>