@page
@model InversionOfControl.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div>
    <h2>User Information</h2>
    <p><strong>User Name:</strong> @Model.UserName</p>
    <p><strong>Birth Date:</strong> @Model.BirthDate.ToString("MMMM dd, yyyy")</p>
    <p><strong>Age:</strong> @Model.UserAge years old</p>
    <p><strong>Administrator:</strong> @(Model.IsAdmin ? "Yes" : "No")</p>
    <p><strong>Creation Time:</strong> @Model.CreationTime.ToString("MMMM dd, yyyy hh:mm:ss tt")</p>
</div>