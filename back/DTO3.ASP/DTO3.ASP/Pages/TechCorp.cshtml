@page
@model DTO3.ASP.Pages.TechCorpModel

@section Title {
    TechCorp
}

@section Styles {
    <style>
        body {
            background-color: #f0f8ff;
        }
        .company-name {
            color: #0066cc;
        }
        .company-description {
            background-color: #e6f2ff;
            padding: 15px;
            border-radius: 5px;
        }
    </style>
}

@section CompanyName {
    <h1 class="company-name">TechCorp</h1>
}

@section CompanyDescription {
    <div class="company-description">
        <p>TechCorp is a leading technology company specializing in innovative software solutions and cloud services. We help businesses transform digitally.</p>
    </div>
}

<div class="content-section mt-4">
    <h2>Company Information</h2>
    <p><strong>Founded:</strong> 2010</p>
    <p><strong>Employees:</strong> 500+</p>
    <p><strong>Location:</strong> Silicon Valley, USA</p>
    <p><strong>Services:</strong> Software Development, Cloud Computing, AI Solutions</p>
</div>